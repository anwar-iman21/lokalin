APP_NAME=LOKALIN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - default MySQL. You can switch to sqlite for a quick local demo
# (see README "Cara Cepat dengan SQLite").
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lokalin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_DRIVER=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@lokalin.test"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: AI Business Assistant (UMKM dashboard).
# Leave empty to automatically use the built-in rule-based fallback generator
# -- the feature stays fully demoable without any external API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
